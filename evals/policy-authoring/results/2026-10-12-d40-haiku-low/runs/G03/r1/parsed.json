    {
      "file": "CONF-011.xs",
      "ok": true,
      "key": "CONF-011",
      "title": "Sensitive fields are marked sensitive",
      "statement": "The cardholder fields are marked sensitive wherever a table declares them, so they are kept out of responses and saved views. Marking a field does not make it safe to store: PCI-001 forbids storing card numbers, security codes, expiry dates and cardholder names.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "CONF-011.R1",
          "title": "Listed fields are marked sensitive",
          "check": "table.field_attribute_required",
          "params": {
            "field_names": [
              "card_number",
              "card_cvv",
              "card_expiry",
              "cardholder_name"
            ],
            "field_types": [],
            "attribute": "sensitive",
            "value": true,
            "type": "",
            "must_exist": false,
            "forbidden": false,
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "DATA-010.xs",
      "ok": true,
      "key": "DATA-010",
      "title": "Endpoints don't return personal data",
      "statement": "Endpoints never fetch card numbers, security codes, expiry dates or cardholder names, or any field marked sensitive in its table's schema. Card details are shown to callers only as the processor's token or last four digits.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "DATA-010.R1",
          "title": "",
          "check": "db.output_fields_forbidden",
          "params": {
            "fields": [
              "card_number",
              "card_cvv",
              "card_expiry",
              "cardholder_name"
            ],
            "include_sensitive": true,
            "table_tags": [],
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [
              "query"
            ],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "LOG-001.xs",
      "ok": true,
      "key": "LOG-001",
      "title": "Logs don't contain request, user or secret data",
      "statement": "Logs never record request input, the logged-in user or environment values. Card numbers, security codes and cardholder details are never logged, whether to debug logs or to Datadog. Log the event and the record id, not the input.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "LOG-001.R1",
          "title": "Logs name events, not input, auth or env",
          "check": "statement.expression_rule",
          "params": {
