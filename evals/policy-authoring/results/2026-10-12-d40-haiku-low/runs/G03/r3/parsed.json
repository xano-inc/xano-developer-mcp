    {
      "file": "PCI-001.xs",
      "ok": true,
      "key": "PCI-001",
      "title": "Cardholder data is never stored raw",
      "statement": "No table declares a card number, security code (CVV), expiry or cardholder name. Send card details to the payment processor and keep only its token or payment intent id. A security code must never be stored, even encrypted. A table that needs one of these fields is reported; removing or retyping an existing field loses data, so the owner decides how to migrate it.",
      "enforcement": "advisory",
      "active": true,
      "severity": "critical",
      "rules": [
        {
          "id": "PCI-001.R1",
          "title": "",
          "check": "table.field_attribute_required",
          "params": {
            "field_names": [
              "card_number",
              "card_cvv",
              "card_expiry",
              "cardholder_name"
            ],
            "field_types": [],
            "attribute": "",
            "value": true,
            "type": "",
            "must_exist": false,
            "forbidden": true,
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "VND-001.xs",
      "ok": true,
      "key": "VND-001",
      "title": "Data only goes to approved vendors",
      "statement": "Outbound requests, cloud and email providers and AI model providers are limited to the vendors you approve. Approved for cardholder and bank data: Stripe (api.stripe.com) and Plaid (production.plaid.com). Any other host or provider is reported until the policy owner approves it here; approving a vendor is the owner's decision, not a code change.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "VND-001.R1",
          "title": "",
