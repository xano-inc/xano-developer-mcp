  "policies": [
    {
      "file": "build/policies/AGENT-001.xs",
      "ok": true,
      "key": "AGENT-001",
      "title": "Agents use only approved tools, and deletes and emails wait for approval",
      "statement": "AI agents enable only the tools the owner has approved. Every tool that deletes a record or sends an email calls require_approval first, so a person must approve the action.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "AGENT-001.R1",
          "title": "Support Agent enables only its approved tools",
          "check": "agent.tool_allowlist",
          "params": {
            "tools": [
              "lookup_order",
              "delete_customer_note",
              "send_customer_email",
              "issue_refund"
            ],
            "tool_tags": [],
            "external_tools": [],
            "tags": [],
            "api_groups": [],
            "paths": [],
            "except_paths": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [
              "agent"
            ],
            "reaching_table_tags": []
          }
        },
        {
          "id": "AGENT-001.R2",
          "title": "Deletes and emails in tools wait for require_approval",
          "check": "stack.statement_order",
          "params": {
            "before": {
              "functions": [
                "require_approval"
              ]
            },
            "after": [
              "db.del",
              "db.bulk.delete",
              "util.send_email"
            ],
            "tags": [],
            "api_groups": [],
            "paths": [],
            "except_paths": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [
              "tool"
            ],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": [
        {
          "rule_id": "AGENT-001.R2",
          "text": "Function \"require_approval\" is not on this branch, so it never satisfies this rule."
        }
      ]
    }
  ]
}
