--- a/function/record_audit_event.xs
+++ b/function/record_audit_event.xs
@@ -0,0 +1,21 @@
+// Adds one audit_log row for a change to an audited table, recording the signed-in user. The only function that writes the audit log.
+function record_audit_event {
+  input {
+    text table_name
+    int record_id
+    text action
+  }
+
+  stack {
+    db.add audit_log {
+      data = {
+        actor_id  : $auth.id
+        table_name: $input.table_name
+        record_id : $input.record_id
+        action    : $input.action
+      }
+    } as $entry
+  }
+
+  response = $entry
+}
--- a/policies/AUDIT-001.xs
+++ b/policies/AUDIT-001.xs
@@ -0,0 +1,18 @@
+policy "AUDIT-001" {
+  title = "Only the audit function writes the audit log"
+  statement = "The audit log table audit_log exists, and only record_audit_event writes to it. Nothing else adds, edits or deletes an audit entry. Evidence of who changed what depends on this."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc8.1", "audit"]
+
+  rule {
+    check = "workspace.object_required"
+    params = { object_kind: "table", names: ["audit_log"] }
+  }
+
+  rule {
+    check = "table.write_location_restricted"
+    params = { restricted_tables: ["audit_log"], allowed_functions: ["record_audit_event"] }
+  }
+}
--- a/policies/AUDIT-002.xs
+++ b/policies/AUDIT-002.xs
@@ -0,0 +1,28 @@
+policy "AUDIT-002" {
+  title = "Changes to audited tables are recorded"
+  statement = "Every edit, patch and delete of the audited tables refunds, customers, tenants and users calls record_audit_event unconditionally in the same stack, so each change leaves an audit_log entry. Audit entries are never edited or deleted. A change this check cannot see (a write in a function that is not an endpoint or task) is not covered; say so before relying on it."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc8.1", "audit"]
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.edit", tables: ["refunds", "customers", "tenants", "users"] } }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.patch", tables: ["refunds", "customers", "tenants", "users"] } }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.del", tables: ["refunds", "customers", "tenants", "users"] } }
+  }
+
+  rule {
+    check = "table.write_location_restricted"
+    params = { restricted_tables: ["audit_log"], statements: ["db.edit", "db.patch", "db.add_or_edit", "db.del", "db.truncate", "db.bulk.update", "db.bulk.patch", "db.bulk.delete"] }
+  }
+}
--- a/table/audit_log.xs
+++ b/table/audit_log.xs
@@ -0,0 +1,20 @@
+// One row per edit, patch or delete of an audited table: who made it, which table and record, the action and when. Written only by record_audit_event.
+table audit_log {
+  auth = false
+
+  schema {
+    int id
+    timestamp created_at?=now
+    int actor_id? {
+      table = "users"
+    }
+
+    text table_name
+    int record_id
+    enum action {
+      values = ["edit", "patch", "delete"]
+    }
+  }
+
+  index = [{type: "primary", field: [{name: "id"}]}]
+}
