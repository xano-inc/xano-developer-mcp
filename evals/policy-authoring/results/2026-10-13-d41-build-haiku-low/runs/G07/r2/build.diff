--- a/function/record_audit_event.xs
+++ b/function/record_audit_event.xs
@@ -0,0 +1,22 @@
+// Adds one audit_log row for an edit or delete. The only function that writes audit_log.
+function record_audit_event {
+  input {
+    int user_id
+    text table_name
+    int record_id
+    text action
+  }
+
+  stack {
+    db.add audit_log {
+      data = {
+        user_id    : $input.user_id
+        table_name : $input.table_name
+        record_id  : $input.record_id
+        action     : $input.action
+      }
+    } as $entry
+  }
+
+  response = $entry
+}
--- a/function/require_role.xs
+++ b/function/require_role.xs
@@ -0,0 +1,20 @@
+// Stops the request unless the user is an admin. Admin endpoints call it first.
+function require_role {
+  input {
+    int user_id
+  }
+
+  stack {
+    db.get users {
+      field_name = "id"
+      field_value = $input.user_id
+    } as $user
+
+    precondition ($user.role == "admin") {
+      error_type = "accessdenied"
+      error = "Admins only."
+    }
+  }
+
+  response = $user
+}
--- a/policies/AUDIT-EDITS.xs
+++ b/policies/AUDIT-EDITS.xs
@@ -0,0 +1,18 @@
+policy "AUDIT-EDITS" {
+  title = "Edits of audited records call the audit function"
+  statement = "Every endpoint that edits or patches a tenant, refund, user, customer or product must call record_audit_event unconditionally in its own stack, so the change is recorded in audit_log. Deletes inside functions are not inspected by this policy. Related to SOC 2 CC8.1 (change management). A pass shows the stored definitions matched when it ran, not that every change is recorded."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc8.1"]
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: {statement: "db.edit", tables: ["tenants", "refunds"]} }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: {statement: "db.patch", tables: ["users", "customers", "products"]} }
+  }
+}
--- a/policies/AUTH-002.xs
+++ b/policies/AUTH-002.xs
@@ -0,0 +1,18 @@
+policy "AUTH-002" {
+  title = "Admin endpoints check the caller's role"
+  statement = "Every endpoint in the admin API group, and every endpoint under the admin path, must call require_role first, passing the logged-in user, so only admins reach them. Related to SOC 2 CC6.3 (role-based access). A pass shows the stored definitions matched when it ran. It does not show that the admin role is right or who holds it."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc6.3"]
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["require_role"], placement: "first", must_reference: ["$auth"], api_groups: ["admin"], object_kinds: ["query"] }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["require_role"], placement: "first", must_reference: ["$auth"], paths: ["admin"], object_kinds: ["query"] }
+  }
+}
--- a/policies/AUTH-030.xs
+++ b/policies/AUTH-030.xs
@@ -0,0 +1,13 @@
+policy "AUTH-030" {
+  title = "Users can't make themselves admin"
+  statement = "No write may take the role field straight from request input, so a caller cannot promote their own account. Related to SOC 2 CC6.3 (role-based access). A pass shows the stored definitions matched when it ran."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc6.3"]
+
+  rule {
+    check = "db.write_from_input_forbidden"
+    params = { fields: ["role"] }
+  }
+}
--- a/policies/RET-001.xs
+++ b/policies/RET-001.xs
@@ -0,0 +1,18 @@
+policy "RET-001" {
+  title = "Only the audit function writes the audit log"
+  statement = "The audit_log table must exist, and only record_audit_event may write it, so no entry can be edited or deleted by other code. Related to SOC 2 CC8.1 (change management). A pass shows the stored definitions matched when it ran, not that the audit trail is complete."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc8.1"]
+
+  rule {
+    check = "workspace.object_required"
+    params = { object_kind: "table", names: ["audit_log"] }
+  }
+
+  rule {
+    check = "table.write_location_restricted"
+    params = { restricted_tables: ["audit_log"], allowed_functions: ["record_audit_event"] }
+  }
+}
--- a/table/audit_log.xs
+++ b/table/audit_log.xs
@@ -0,0 +1,18 @@
+// One row per edit or delete of a business record: who made it, which table and record, the action and when. Written only by record_audit_event.
+table audit_log {
+  auth = false
+
+  schema {
+    int id
+    timestamp created_at?=now
+    int user_id? {
+      table = "users"
+    }
+
+    text table_name
+    int record_id
+    text action
+  }
+
+  index = [{type: "primary", field: [{name: "id"}]}]
+}
