--- a/function/require_admin_role.xs
+++ b/function/require_admin_role.xs
@@ -0,0 +1,20 @@
+// Stops the caller unless their role is admin or support_lead. Called first by every /admin endpoint.
+function require_admin_role {
+  input {
+    int user_id
+  }
+
+  stack {
+    db.get users {
+      field_name = "id"
+      field_value = $input.user_id
+    } as $user
+
+    precondition ($user.role == "admin" || $user.role == "support_lead") {
+      error_type = "accessdenied"
+      error = "You need the admin or support_lead role."
+    }
+  }
+
+  response = {role: $user.role}
+}
--- a/policies/AUTH-002.xs
+++ b/policies/AUTH-002.xs
@@ -0,0 +1,19 @@
+policy "AUTH-002" {
+  title = "Admin endpoints check the caller's role"
+  statement = "Every endpoint under /admin must call require_admin_role as its first statement, passing the logged-in user, before doing anything else. require_admin_role stops the request unless the user's role is admin or support_lead. The policy confirms the call comes first, not that the function compares the right roles."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "hipaa"]
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["require_admin_role"],
+      placement: "first",
+      must_reference: ["$auth"],
+      paths: ["admin"],
+      object_kinds: ["query"]
+    }
+  }
+}
--- a/policies/TENANT-010.xs
+++ b/policies/TENANT-010.xs
@@ -0,0 +1,16 @@
+policy "TENANT-010" {
+  title = "Tenant rows are read and written only within an org"
+  statement = "Every read and write of the tenants table must filter on org_id, so no statement touches a tenant row without naming its org. The policy checks that an org_id filter is present, not that it matches the caller's own org."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2"]
+
+  rule {
+    check = "db.where_constraint_required"
+    params = {
+      field: "org_id",
+      table_selector: {names: ["tenants"]}
+    }
+  }
+}
