--- a/function/require_admin_role.xs
+++ b/function/require_admin_role.xs
@@ -0,0 +1,20 @@
+// Stops the request unless the user is an admin or a support lead. Reads the role from the database, not the login token.
+function require_admin_role {
+  input {
+    int user_id
+  }
+
+  stack {
+    db.get users {
+      field_name = "id"
+      field_value = $input.user_id
+    } as $user
+
+    precondition ($user.role == "admin" || $user.role == "support_lead") {
+      error_type = "accessdenied"
+      error = "Admin or support lead role required."
+    }
+  }
+
+  response = $user.role
+}
--- a/policies/AUTH-002.xs
+++ b/policies/AUTH-002.xs
@@ -0,0 +1,13 @@
+policy "AUTH-002" {
+  title = "Admin endpoints check the caller's role"
+  statement = "Every endpoint under the /admin path calls the require_admin_role function as its first statement, passing the logged-in user. The function stops the request unless the user's role is admin or support_lead."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "hipaa"]
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["require_admin_role"], placement: "first", must_reference: ["$auth"], paths: ["admin"], object_kinds: ["query"] }
+  }
+}
--- a/policies/AUTH-020.xs
+++ b/policies/AUTH-020.xs
@@ -0,0 +1,13 @@
+policy "AUTH-020" {
+  title = "Tenant reads and writes filter by org_id"
+  statement = "Every read and write of the tenants table filters on org_id, so no request reaches tenant rows across orgs without an org_id filter."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "hipaa"]
+
+  rule {
+    check = "db.where_constraint_required"
+    params = { field: "org_id", table_selector: { names: ["tenants"] } }
+  }
+}
