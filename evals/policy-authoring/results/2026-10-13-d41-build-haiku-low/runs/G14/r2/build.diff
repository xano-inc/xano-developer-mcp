--- a/function/record_audit_event.xs
+++ b/function/record_audit_event.xs
@@ -0,0 +1,22 @@
+// Adds one audit_log row for a change to an audited table. The only function allowed to write audit_log.
+function record_audit_event {
+  input {
+    text table_name
+    int record_id
+    text action
+    int actor_id?
+  }
+
+  stack {
+    db.add audit_log {
+      data = {
+        table_name: $input.table_name
+        record_id : $input.record_id
+        action    : $input.action
+        actor_id  : $input.actor_id
+      }
+    } as $entry
+  }
+
+  response = $entry
+}
--- a/policies/AUDIT-001.xs
+++ b/policies/AUDIT-001.xs
@@ -0,0 +1,71 @@
+policy "AUDIT-001" {
+  title = "Changes to customer-email tables are audited"
+  statement = "Every add, edit, patch and delete of a table that stores customer emails calls the record_audit_event function, which is the only writer of the audit_log table, so the log can answer who changed what. Audit entries are never edited or deleted. Bulk writes are not judged by this policy, and functions that write are not inspected by the call rules."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "workspace.object_required"
+    params = {
+      object_kind: "table"
+      names: ["audit_log"]
+    }
+  }
+
+  rule {
+    check = "table.write_location_restricted"
+    params = {
+      restricted_tables: ["audit_log"]
+      allowed_functions: ["record_audit_event"]
+    }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["record_audit_event"]
+      placement: "unconditional"
+      when: {
+        statement: "db.add"
+        tables: ["customers", "users", "newsletter_subscribers", "support_tickets", "patients"]
+      }
+    }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["record_audit_event"]
+      placement: "unconditional"
+      when: {
+        statement: "db.edit"
+        tables: ["customers", "users", "newsletter_subscribers", "support_tickets", "patients"]
+      }
+    }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["record_audit_event"]
+      placement: "unconditional"
+      when: {
+        statement: "db.patch"
+        tables: ["customers", "users", "newsletter_subscribers", "support_tickets", "patients"]
+      }
+    }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["record_audit_event"]
+      placement: "unconditional"
+      when: {
+        statement: "db.del"
+        tables: ["customers", "users", "newsletter_subscribers", "support_tickets", "patients"]
+      }
+    }
+  }
+}
--- a/policies/COST-001.xs
+++ b/policies/COST-001.xs
@@ -0,0 +1,23 @@
+policy "COST-001" {
+  title = "AI calls and background retries stay bounded"
+  statement = "AI agent and MCP tool calls are never made inside a loop, so one run cannot multiply into an unbounded bill. Background tasks use no while loop, so a failing step cannot keep retrying. The while rule is an approximation: it bans the loop shape, not every other way a task can retry. Spend caps and retry limits are not checked by this policy."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.containment"
+    params = {
+      statements: ["ai.agent.run", "ai.external.mcp.tool.run"]
+      must_not_be_inside: ["foreach", "for", "while"]
+    }
+  }
+
+  rule {
+    check = "stack.statement_forbidden"
+    params = {
+      statements: ["while"]
+      object_kinds: ["task"]
+    }
+  }
+}
--- a/table/audit_log.xs
+++ b/table/audit_log.xs
@@ -0,0 +1,15 @@
+// One row per change to a table that stores customer emails: who made it, which table and record, what was done, and when.
+table audit_log {
+  auth = false
+
+  schema {
+    int id
+    timestamp created_at?=now
+    text table_name
+    int record_id
+    text action
+    int actor_id?
+  }
+
+  index = [{type: "primary", field: [{name: "id"}]}]
+}
