--- a/policies/LOG-010.xs
+++ b/policies/LOG-010.xs
@@ -0,0 +1,28 @@
+policy "LOG-010" {
+  title = "External calls handle their own failures"
+  statement = "Every external call sits inside a try block, so a vendor failure reaches error handling instead of hanging or crashing the request. An external call that cannot be wrapped must be flagged to the platform owner before it is exempted."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+  tags = []
+
+  rule {
+    check = "statement.containment"
+    params = {
+      statements: [
+        "api.request",
+        "stream.from_request",
+        "webflow.request",
+        "ai.external.mcp.tool.run",
+        "ai.external.mcp.tool.list",
+        "ai.external.mcp.server_details",
+        "db.external.mysql.direct_query",
+        "db.external.postgres.direct_query",
+        "db.external.mssql.direct_query",
+        "db.external.oracle.direct_query",
+        "db.external.snowflake.direct_query"
+      ]
+      must_be_inside: ["try_catch"]
+    }
+  }
+}
--- a/policies/SEC-013.xs
+++ b/policies/SEC-013.xs
@@ -0,0 +1,26 @@
+policy "SEC-013" {
+  title = "External requests time out quickly"
+  statement = "Every external HTTP request sets its own timeout of 30 seconds or less, so one slow vendor cannot stall the workspace. A request that leaves timeout unset runs at the platform default and is reported, so the timeout is always written in the code. MCP and external database calls take no timeout and are not covered by this policy."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+  tags = []
+
+  rule {
+    check = "statement.param_required"
+    params = {
+      statements: ["api.request", "stream.from_request", "webflow.request"]
+      param_names: ["timeout"]
+    }
+  }
+
+  rule {
+    check = "statement.param_bound"
+    params = {
+      statements: ["api.request", "stream.from_request", "webflow.request"]
+      param_names: ["timeout"]
+      max: 30
+      unit: "seconds"
+    }
+  }
+}
