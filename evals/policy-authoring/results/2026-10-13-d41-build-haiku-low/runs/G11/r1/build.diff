--- a/policies/LOG-010.xs
+++ b/policies/LOG-010.xs
@@ -0,0 +1,12 @@
+policy "LOG-010" {
+  title = "External calls handle their own failures"
+  statement = "Every external call (api.request, stream.from_request, webflow.request, api.microservice, api.lambda, the ai.external.mcp statements and the db.external direct queries) must sit inside a try block, so a vendor failure reaches error handling. The catch branch must decide what the caller sees. A call that cannot be wrapped is raised with the policy owner, never exempted by the author."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.containment"
+    params = {statements: ["api.request", "stream.from_request", "webflow.request", "api.microservice", "api.lambda", "ai.external.mcp.tool.run", "ai.external.mcp.tool.list", "ai.external.mcp.server_details", "db.external.postgres.direct_query", "db.external.mysql.direct_query", "db.external.mssql.direct_query", "db.external.oracle.direct_query", "db.external.snowflake.direct_query"], must_be_inside: ["try_catch"]}
+  }
+}
--- a/policies/SEC-013.xs
+++ b/policies/SEC-013.xs
@@ -0,0 +1,17 @@
+policy "SEC-013" {
+  title = "External requests time out quickly"
+  statement = "Every external request (api.request, stream.from_request, webflow.request, api.microservice, api.lambda) must set a timeout of at most 30 seconds, so one slow vendor cannot stall the workspace. A request that cannot take a timeout is raised with the policy owner, never exempted by the author."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.param_bound"
+    params = {statements: ["api.request", "stream.from_request", "webflow.request", "api.microservice", "api.lambda"], param_names: ["timeout"], max: 30, unit: "seconds"}
+  }
+
+  rule {
+    check = "statement.param_required"
+    params = {statements: ["api.request", "stream.from_request", "webflow.request", "api.microservice", "api.lambda"], param_names: ["timeout"]}
+  }
+}
