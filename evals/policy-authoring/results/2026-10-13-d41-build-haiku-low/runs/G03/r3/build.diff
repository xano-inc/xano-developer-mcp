--- a/policies/CONF-011.xs
+++ b/policies/CONF-011.xs
@@ -0,0 +1,13 @@
+policy "CONF-011" {
+  title = "Sensitive fields are marked sensitive"
+  statement = "The card and bank fields are marked sensitive wherever a table declares them, so DATA-010 and the saved-view checks keep them out of responses and views. Fields: card_number, card_cvv, card_expiry, cardholder_name, card_last4, bank_account_number, bank_routing_number. A field added later under a different name is not found by this rule; add it to the list."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci", "soc2"]
+
+  rule {
+    check = "table.field_attribute_required"
+    params = {field_names: ["card_number", "card_cvv", "card_expiry", "cardholder_name", "card_last4", "bank_account_number", "bank_routing_number"], attribute: "sensitive"}
+  }
+}
--- a/policies/DATA-010.xs
+++ b/policies/DATA-010.xs
@@ -0,0 +1,13 @@
+policy "DATA-010" {
+  title = "Endpoints don't return personal data"
+  statement = "No endpoint returns card or bank fields: card_number, card_cvv, card_expiry, cardholder_name, bank_account_number or bank_routing_number. Callers that need a payment's status read stripe_payment_intent_id and status instead. Changing this list is the policy owner's decision."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci", "soc2", "gdpr"]
+
+  rule {
+    check = "db.output_fields_forbidden"
+    params = {fields: ["card_number", "card_cvv", "card_expiry", "cardholder_name", "bank_account_number", "bank_routing_number"], object_kinds: ["query"]}
+  }
+}
--- a/policies/LOG-001.xs
+++ b/policies/LOG-001.xs
@@ -0,0 +1,13 @@
+policy "LOG-001" {
+  title = "Logs don't contain request, user or secret data"
+  statement = "Debug logs never reference request input, the logged-in user or environment values, so card numbers, CVVs and cardholder names never reach the log. Logging an event (for example that a charge was attempted, with the invoice id) is allowed; logging the request body is not. Applies to debug.log here; datadog.log is covered by PCI-CARD-001."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci", "soc2", "gdpr"]
+
+  rule {
+    check = "statement.expression_rule"
+    params = {statements: ["debug.log"], param_names: ["value"], must_not_reference: ["$input", "$auth", "$env"]}
+  }
+}
--- a/policies/PCI-CARD-001.xs
+++ b/policies/PCI-CARD-001.xs
@@ -0,0 +1,23 @@
+policy "PCI-CARD-001" {
+  title = "Cardholder data is tagged, never stored raw, and kept out of logs"
+  statement = "Cardholder data is kept out of the workspace's stored schema and logs. Any table with a card number, CVV, expiry or cardholder name carries the pci tag. No table stores a full card number (card_number, pan) or a security code (card_cvv, cvv, cvc); a card is held only as a processor token and its last four digits. Datadog log messages and attributes never reference request input, the logged-in user or environment values. Stored raw card data is reported here until it is removed: removing it is the owner's decision because it changes stored data."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci"]
+
+  rule {
+    check = "table.tag_required"
+    params = {field_names: ["card_number", "card_cvv", "card_expiry", "cardholder_name"], tag: "pci"}
+  }
+
+  rule {
+    check = "table.field_attribute_required"
+    params = {field_names: ["card_number", "card_cvv", "cvv", "cvc", "pan"], forbidden: true}
+  }
+
+  rule {
+    check = "statement.expression_rule"
+    params = {statements: ["datadog.log"], param_names: ["message", "attributes"], must_not_reference: ["$input", "$auth", "$env"]}
+  }
+}
--- a/policies/SEC-011.xs
+++ b/policies/SEC-011.xs
@@ -0,0 +1,13 @@
+policy "SEC-011" {
+  title = "External requests verify TLS certificates"
+  statement = "Every external request verifies the TLS certificate and host name of the server it talks to. Cardholder data and bank details travel only over verified TLS, so no api.request or stream.from_request may turn off verify_peer or verify_host."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci", "soc2"]
+
+  rule {
+    check = "statement.param_forbidden"
+    params = {statements: ["api.request", "stream.from_request"], param_names: ["verify_peer", "verify_host"], values: [false]}
+  }
+}
--- a/policies/SEC-012.xs
+++ b/policies/SEC-012.xs
@@ -0,0 +1,13 @@
+policy "SEC-012" {
+  title = "No secrets are hardcoded"
+  statement = "API keys, tokens, private keys and credentialed URLs are never written as literals in an object's definition. The payment processor and bank-link keys are read from workspace environment variables (for example $env.STRIPE_SECRET_KEY and $env.PLAID_SECRET). A literal found here must be moved to an environment variable and the exposed value rotated; a value reviewed as safe is exempted only by its fingerprint, by the policy owner."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci", "soc2"]
+
+  rule {
+    check = "literal.credential_shape"
+    params = {}
+  }
+}
--- a/policies/VND-001.xs
+++ b/policies/VND-001.xs
@@ -0,0 +1,13 @@
+policy "VND-001" {
+  title = "Data only goes to approved vendors"
+  statement = "Outbound requests go only to the vendors on the approved list: Stripe (api.stripe.com) for card payments and Plaid (production.plaid.com) for bank links. Any other host, including the fraud-screening vendor at api.riskscreen.example, is reported until the policy owner approves it or the call is removed. Approving a vendor is the policy owner's decision: do not add a host to this list without their sign-off."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci", "soc2"]
+
+  rule {
+    check = "outbound.vendor_allowlist"
+    params = {kinds: ["http"], hosts: ["api.stripe.com", "production.plaid.com"]}
+  }
+}
