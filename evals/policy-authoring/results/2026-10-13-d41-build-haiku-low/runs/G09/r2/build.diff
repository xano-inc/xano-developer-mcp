--- a/policies/ERASE-001.xs
+++ b/policies/ERASE-001.xs
@@ -0,0 +1,18 @@
+policy "ERASE-001" {
+  title = "Account deletion erases personal data everywhere"
+  statement = "Every table tagged personal must be reached by the erasure function, the one function tagged erasure, which deletes a person's rows with db.del or db.bulk.delete. Endpoints that reach the deletion path require login. A table that cannot be erased is exempted by its owner, never by the author."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["gdpr"]
+
+  rule {
+    check = "table.coverage_required"
+    params = { tags: ["personal"], referenced_by: { object_kinds: ["function"], tags: ["erasure"], statements: ["db.del", "db.bulk.delete"] } }
+  }
+
+  rule {
+    check = "object.auth_required"
+    params = { object_kinds: ["query"], paths: ["account"] }
+  }
+}
--- a/policies/RET-003.xs
+++ b/policies/RET-003.xs
@@ -0,0 +1,13 @@
+policy "RET-003" {
+  title = "Retained data is deleted after a set number of days"
+  statement = "Tables tagged retained are deleted after a set number of days. Each must be reached by an active scheduled task that deletes its rows once created_at is older than 730 days. A table that cannot follow this rule is exempted by its owner, never by the author."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+  tags = ["gdpr", "soc2"]
+
+  rule {
+    check = "table.coverage_required"
+    params = { tags: ["retained"], referenced_by: { object_kinds: ["task"], max_age_days: 730 } }
+  }
+}
--- a/task/purge_expired_support_tickets.xs
+++ b/task/purge_expired_support_tickets.xs
@@ -0,0 +1,10 @@
+// Deletes support tickets older than two years every night.
+task purge_expired_support_tickets {
+  stack {
+    db.bulk.delete support_tickets {
+      where = $db.support_tickets.created_at < now|timestamp_subtract_days:730
+    } as $purged
+  }
+
+  schedule = [{starts_on: 2026-01-01 04:00:00+0000, freq: 86400}]
+}
