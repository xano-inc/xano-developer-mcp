--- a/function/require_manager.xs
+++ b/function/require_manager.xs
@@ -0,0 +1,20 @@
+// Stops the call unless the user is a manager. Reads the role from the users table, never from the token.
+function require_manager {
+  input {
+    int user_id
+  }
+
+  stack {
+    db.get users {
+      field_name = "id"
+      field_value = $input.user_id
+    } as $user
+
+    precondition ($user.role == "manager") {
+      error_type = "accessdenied"
+      error = "Only managers can do this."
+    }
+  }
+
+  response = true
+}
--- a/policies/AUTH-030.xs
+++ b/policies/AUTH-030.xs
@@ -0,0 +1,13 @@
+policy "AUTH-030" {
+  title = "Users can't make themselves admin"
+  statement = "Request input never writes a user's role. Only a manager can change prices or approve refunds, and no one can give themselves the manager role."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "hipaa"]
+
+  rule {
+    check = "db.write_from_input_forbidden"
+    params = { fields: ["role"] }
+  }
+}
--- a/policies/MGR-010.xs
+++ b/policies/MGR-010.xs
@@ -0,0 +1,19 @@
+policy "MGR-010" {
+  title = "Refund approval and price changes check for a manager"
+  statement = "Every endpoint that approves a refund or changes a product price calls the manager check first, before it writes anything."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["manager-only"]
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["require_manager"],
+      placement: "first",
+      must_reference: ["$auth"],
+      paths: ["refunds/*/approve", "products/*/price"],
+      object_kinds: ["query"]
+    }
+  }
+}
