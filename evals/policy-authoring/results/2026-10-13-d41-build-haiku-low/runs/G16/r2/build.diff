--- a/function/require_manager.xs
+++ b/function/require_manager.xs
@@ -0,0 +1,19 @@
+// Stops the call unless the logged-in user is a manager (or an admin). Call it first in any endpoint that approves refunds or changes prices.
+function require_manager {
+  input {
+  }
+
+  stack {
+    db.get users {
+      field_name = "id"
+      field_value = $auth.id
+    } as $me
+
+    precondition ($me.role == "manager" || $me.role == "admin") {
+      error_type = "accessdenied"
+      error = "Only managers can do this."
+    }
+  }
+
+  response = $me
+}
--- a/policies/AUTH-030.xs
+++ b/policies/AUTH-030.xs
@@ -0,0 +1,13 @@
+policy "AUTH-030" {
+  title = "Users can't make themselves admin"
+  statement = "Record writes never take a privilege field such as role or is_admin from request input, nor a whole record from it. A user cannot grant themselves a manager or admin role."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "hipaa"]
+
+  rule {
+    check = "db.write_from_input_forbidden"
+    params = { fields: ["role"] }
+  }
+}
--- a/policies/ROLE-010.xs
+++ b/policies/ROLE-010.xs
@@ -0,0 +1,26 @@
+policy "ROLE-010" {
+  title = "Refund approvals and price changes need a manager"
+  statement = "Any object that writes the refunds or products tables must first call the require_manager function, so only managers can approve refunds or change prices. Endpoints tagged manager-only must call require_manager as their first statement. Staff can still read these tables."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["role-access"]
+
+  rule {
+    check = "stack.statement_order"
+    params = {
+      before: {functions: ["require_manager"]}
+      after: ["db.edit", "db.patch", "db.add", "db.del"]
+      tables: ["refunds", "products"]
+    }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["require_manager"]
+      placement: "first"
+      tags: ["manager-only"]
+    }
+  }
+}
