  "policies": [
    {
      "file": "LOG-001.xs",
      "ok": true,
      "key": "LOG-001",
      "title": "Logs don't contain request, user or secret data",
      "statement": "Debug and Datadog logs never reference request input, the logged-in user or environment variables. Cardholder data (card number, CVV, expiry, cardholder name) and bank account numbers are request input, so they must never reach a log. Log the event, not the values.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "LOG-001.R1",
          "title": "",
          "check": "statement.expression_rule",
          "params": {
            "statements": [
              "debug.log",
              "datadog.log"
            ],
            "param_names": [
              "value",
              "message"
            ],
            "must_reference": [],
            "must_not_reference": [
              "$input",
              "$auth",
              "$env"
            ],
            "operators_forbidden": [],
            "literals_forbidden": [],
            "filters_forbidden": [],
            "filters_required": [],
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "PCI-010.xs",
      "ok": true,
      "key": "PCI-010",
      "title": "Cardholder and bank account data is not stored raw",
      "statement": "Card numbers, CVVs, card expiry dates, cardholder names and bank account or routing numbers must not be stored as plain fields in any table. Store a processor token instead (for example Stripe's payment method id). A field that holds one of these values under another name is not caught by this rule.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "PCI-010.R1",
          "title": "",
          "check": "table.field_attribute_required",
          "params": {
            "field_names": [
              "card_number",
              "card_cvv",
              "card_expiry",
              "cardholder_name",
              "bank_account_number",
              "bank_routing_number"
            ],
            "field_types": [],
            "attribute": "",
            "value": true,
            "type": "",
            "must_exist": false,
            "forbidden": true,
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "VND-001.xs",
      "ok": true,
      "key": "VND-001",
      "title": "Data only goes to approved vendors",
      "statement": "Outbound requests only go to vendors the business has approved for cardholder and bank data: Stripe (api.stripe.com) and Plaid (production.plaid.com). Any other destination, including email and SMS providers, is reported until the owner approves it. Adding a vendor is the policy owner's decision.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "VND-001.R1",
          "title": "",
          "check": "outbound.vendor_allowlist",
          "params": {
            "kinds": [],
            "hosts": [
              "api.stripe.com",
              "production.plaid.com"
            ],
            "providers": [],
            "env_hosts": [],
            "literal_urls_forbidden": false,
