      "ok": true,
      "key": "AUTH-010",
      "title": "Endpoints require login",
      "statement": "Every endpoint requires authentication, unless it is deliberately open to anonymous callers and carries the `public` tag, signed off by the platform owner. Related to HIPAA access control for ePHI.",
      "enforcement": "advisory",
      "active": true,
      "severity": "critical",
      "rules": [
        {
          "id": "AUTH-010.R1",
          "title": "",
          "check": "object.auth_required",
          "params": {
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [
              "public"
            ],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "CONF-010.xs",
      "ok": true,
      "key": "CONF-010",
      "title": "Sensitive tables are only reached by logged-in endpoints",
      "statement": "Every endpoint that reaches a table tagged `confidential`, directly or through a function, requires authentication. Related to HIPAA access control for ePHI. Depends on the confidential tag being set on the patient, appointment and clinical note tables; until it is, this rule matches no table.",
