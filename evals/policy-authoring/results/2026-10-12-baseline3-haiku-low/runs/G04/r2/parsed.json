      "file": "AUTH-010.xs",
      "ok": true,
      "key": "AUTH-010",
      "title": "Endpoints require login",
      "statement": "HIPAA access control: every endpoint requires a logged-in user, so an anonymous caller cannot reach patient, appointment or clinical note data. A deliberately public endpoint carries the `public` tag, signed off by the platform owner.",
      "enforcement": "advisory",
      "active": true,
      "severity": "critical",
      "rules": [
        {
          "id": "AUTH-010.R1",
          "title": "",
          "check": "object.auth_required",
          "params": {
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [
              "public"
            ],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "AUTH-020.xs",
      "ok": true,
      "key": "AUTH-020",
      "title": "Users only reach their own records",
      "statement": "HIPAA access control: a logged-in user reads and writes patient records only within their own organisation. Every read of patients filters on org_id against the logged-in user's org_id, and a new patient takes its org_id from the login, never from the request.",
      "enforcement": "advisory",
      "active": true,
      "severity": "critical",
      "rules": [
        {
          "id": "AUTH-020.R1",
          "title": "",
          "check": "db.where_constraint_required",
          "params": {
            "table_selector": [],
            "field": "org_id",
