      "key": "AGENT-001",
      "title": "AI agent tools don't delete data",
      "statement": "AI agent tools must not delete records. A tool that deletes data (a db.del or db.bulk.* delete, directly or through a function it calls) is reported. Deletes that a person must approve happen outside agent tools, in the back office.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "AGENT-001.R1",
          "title": "",
          "check": "stack.statement_forbidden",
          "params": {
            "statements": [
              "db.del",
              "db.bulk.*"
            ],
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [
              "tool"
            ],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "AGENT-002.xs",
      "ok": true,
      "key": "AGENT-002",
      "title": "AI agent tools that email customers need human approval first",
      "statement": "An AI agent tool that sends email (util.send_email, directly or through a function it calls) must call request_human_approval as its first statement, so a person approves the email before it is sent. The approval call must pass the approved approval_id; this policy checks only that the call comes first.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "AGENT-002.R1",
          "title": "",
          "check": "object.statement_required",
          "params": {
            "statements": [],
            "functions": [
              "request_human_approval"
            ],
            "placement": "first",
            "must_reference": [],
            "when": {
              "statement": "util.send_email"
            },
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
