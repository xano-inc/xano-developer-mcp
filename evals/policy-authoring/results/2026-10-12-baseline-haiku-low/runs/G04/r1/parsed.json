      "file": "AUTH-010.xs",
      "ok": true,
      "key": "AUTH-010",
      "title": "Endpoints require login",
      "statement": "Every endpoint must require authentication, because patient and appointment data sits behind them (HIPAA Security Rule access control, 45 CFR 164.312(a)). An endpoint that must be public, such as login, signup, webhook or health, carries the `public` tag, signed off by the platform owner.",
      "enforcement": "advisory",
      "active": true,
      "severity": "critical",
      "rules": [
        {
          "id": "AUTH-010.R1",
          "title": "",
          "check": "object.auth_required",
          "params": {
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [
              "public"
            ],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "CONF-011.xs",
      "ok": true,
      "key": "CONF-011",
      "title": "Sensitive fields are marked sensitive",
      "statement": "The patient identifiers and clinical text fields must be marked sensitive in their table schema, so that Xano hides them from saved views and the field checks apply (HIPAA safeguard for PHI, 45 CFR 164.312). Only the listed fields are checked; other personal fields need a policy change.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "CONF-011.R1",
          "title": "",
          "check": "table.field_attribute_required",
          "params": {
            "field_names": [
              "ssn",
              "dob",
