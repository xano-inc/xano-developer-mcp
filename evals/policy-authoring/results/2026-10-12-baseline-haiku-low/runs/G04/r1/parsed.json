      "file": "RET-001.xs",
      "ok": true,
      "key": "RET-001",
      "title": "Only the audit function writes the audit log",
      "statement": "The audit_log table must exist, and only the record_audit_event function may write to it, so that the record of who changed patient data cannot be edited by other code (HIPAA audit controls, 45 CFR 164.312(b)). This does not record reads of patient data; that needs a separate policy.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
