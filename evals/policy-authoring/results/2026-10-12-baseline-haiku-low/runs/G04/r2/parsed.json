      "ok": true,
      "key": "AUTH-010",
      "title": "Endpoints require login",
      "statement": "Every endpoint that reaches the patients, appointments or clinical_notes tables must require a login. An endpoint that must stay public carries the `public` tag, signed off by the platform owner.",
      "enforcement": "advisory",
      "active": true,
      "severity": "critical",
      "rules": [
        {
          "id": "AUTH-010.R1",
          "title": "",
          "check": "object.auth_required",
          "params": {
            "tags": [],
            "api_groups": [],
            "tables": [
              "patients",
              "appointments",
              "clinical_notes"
            ],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [
              "public"
            ],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
    {
      "file": "AUTH-020.xs",
      "ok": true,
      "key": "AUTH-020",
      "title": "Users only reach their own records",
      "statement": "Reads of patients must filter on the logged-in user's org_id, so a user only reaches patients of their own organisation. New patient records take their org_id from the login, not the request.",
      "enforcement": "advisory",
      "active": true,
      "severity": "critical",
      "rules": [
        {
          "id": "AUTH-020.R1",
          "title": "Patient reads filter on the logged-in user's org",
          "check": "db.where_constraint_required",
          "params": {
            "table_selector": {
              "names": [
                "patients"
              ]
            },
            "field": "org_id",
            "compare_to": "$auth.org_id",
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        },
        {
          "id": "AUTH-020.R2",
          "title": "New patient records take their org from the login",
          "check": "db.write_from_input_forbidden",
          "params": {
            "statements": [],
            "fields": [
              "org_id"
            ],
            "tags": [],
            "api_groups": [],
            "tables": [],
            "verbs": [],
            "endpoint_auth": "",
            "except_tags": [],
            "object_kinds": [],
            "reaching_table_tags": []
          }
        }
      ],
      "warnings": []
    },
