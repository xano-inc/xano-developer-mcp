--- a/function/require_human_approval.xs
+++ b/function/require_human_approval.xs
@@ -0,0 +1,20 @@
+// Stops the calling action unless a person has approved the matching approval request.
+function require_human_approval {
+  input {
+    int approval_id
+  }
+
+  stack {
+    db.get approval_requests {
+      field_name = "id"
+      field_value = $input.approval_id
+    } as $approval
+
+    precondition ($approval.status == "approved") {
+      error_type = "accessdenied"
+      error = "A person must approve this action first."
+    }
+  }
+
+  response = $approval
+}
--- a/policies/AGENT-010.xs
+++ b/policies/AGENT-010.xs
@@ -0,0 +1,12 @@
+policy "AGENT-010" {
+  title = "AI agents wait for human approval before deleting or emailing"
+  statement = "An AI agent tool may delete records or send email only after require_human_approval has run in the same tool. A person approves each action in approval_requests first. Tools that do neither are not affected."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "stack.statement_order"
+    params = {before: {functions: ["require_human_approval"]}, after: ["db.del", "db.bulk.delete", "db.truncate", "util.send_email"], object_kinds: ["tool"]}
+  }
+}
--- a/table/approval_requests.xs
+++ b/table/approval_requests.xs
@@ -0,0 +1,16 @@
+// One row per action an AI agent wants to take on a customer. A person sets status to approved before the action runs.
+table approval_requests {
+  auth = false
+
+  schema {
+    int id
+    timestamp created_at?=now
+    text action
+    text target
+    text status?="pending"
+    text decided_by?
+    timestamp decided_at?
+  }
+
+  index = [{type: "primary", field: [{name: "id"}]}]
+}
