--- a/function/record_audit_event.xs
+++ b/function/record_audit_event.xs
@@ -0,0 +1,24 @@
+// Writes one audit_log entry. The only object allowed to write audit_log.
+function record_audit_event {
+  input {
+    text table_name
+    int record_id?
+    text action
+    int actor_id?
+    json changes?
+  }
+
+  stack {
+    db.add audit_log {
+      data = {
+        table_name: $input.table_name
+        record_id : $input.record_id
+        action    : $input.action
+        actor_id  : $input.actor_id
+        changes   : $input.changes
+      }
+    } as $entry
+  }
+
+  response = $entry
+}
--- a/policies/AI-COST-001.xs
+++ b/policies/AI-COST-001.xs
@@ -0,0 +1,15 @@
+policy "AI-COST-001" {
+  title = "AI calls stay out of loops"
+  statement = "An AI agent run or external MCP tool call must not sit inside a loop. A loop multiplies each call by its iteration count, which runs up model spend. An AI call that truly must repeat must be moved out of the loop or reviewed and exempted by the policy owner."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.containment"
+    params = {
+      statements: ["ai.agent.run", "ai.external.mcp.tool.run"]
+      must_not_be_inside: ["foreach", "for", "while"]
+    }
+  }
+}
--- a/policies/AUDIT-001.xs
+++ b/policies/AUDIT-001.xs
@@ -0,0 +1,55 @@
+policy "AUDIT-001" {
+  title = "Changes to customer-email tables are audited"
+  statement = "Every add, edit, patch and delete on a table that stores customer emails must call the record_audit_event function unconditionally, so each change is recorded with who made it. Tables covered: customers, users, newsletter_subscribers, patients, orgs and support_tickets. A table added later that stores emails must be added to these rules. An object that cannot audit its write must be fixed, not exempted, unless the policy owner decides otherwise."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["record_audit_event"]
+      placement: "unconditional"
+      when: {
+        statement: "db.add"
+        tables: ["customers", "users", "newsletter_subscribers", "patients", "orgs", "support_tickets"]
+      }
+    }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["record_audit_event"]
+      placement: "unconditional"
+      when: {
+        statement: "db.edit"
+        tables: ["customers", "users", "newsletter_subscribers", "patients", "orgs", "support_tickets"]
+      }
+    }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["record_audit_event"]
+      placement: "unconditional"
+      when: {
+        statement: "db.patch"
+        tables: ["customers", "users", "newsletter_subscribers", "patients", "orgs", "support_tickets"]
+      }
+    }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["record_audit_event"]
+      placement: "unconditional"
+      when: {
+        statement: "db.del"
+        tables: ["customers", "users", "newsletter_subscribers", "patients", "orgs", "support_tickets"]
+      }
+    }
+  }
+}
--- a/policies/RET-001.xs
+++ b/policies/RET-001.xs
@@ -0,0 +1,23 @@
+policy "RET-001" {
+  title = "Only the audit function writes the audit log"
+  statement = "The audit log table exists, and only the record_audit_event function writes to it. Nothing else may edit, delete or insert audit entries, so the record of who changed what stays trustworthy. A caller can still pass whatever it likes to the audit function."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "workspace.object_required"
+    params = {
+      object_kind: "table"
+      names: ["audit_log"]
+    }
+  }
+
+  rule {
+    check = "table.write_location_restricted"
+    params = {
+      restricted_tables: ["audit_log"]
+      allowed_functions: ["record_audit_event"]
+    }
+  }
+}
--- a/table/audit_log.xs
+++ b/table/audit_log.xs
@@ -0,0 +1,20 @@
+// Append-only record of who changed which row of a table holding customer emails.
+// Written only by record_audit_event.
+table audit_log {
+  auth = false
+
+  schema {
+    int id
+    timestamp created_at?=now
+    text table_name
+    int record_id?
+    text action
+    int actor_id?
+    json changes?
+  }
+
+  index = [
+    {type: "primary", field: [{name: "id"}]}
+    {type: "btree", field: [{name: "table_name", op: "asc"}, {name: "record_id", op: "asc"}]}
+  ]
+}
