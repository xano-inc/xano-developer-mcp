--- a/function/record_audit_event.xs
+++ b/function/record_audit_event.xs
@@ -0,0 +1,22 @@
+// Writes one audit_log row. The only code that writes the audit log.
+function record_audit_event {
+  input {
+    text table_name
+    int record_id
+    text action
+    int? actor_id
+  }
+
+  stack {
+    db.add audit_log {
+      data = {
+        table_name: $input.table_name
+        record_id : $input.record_id
+        action    : $input.action
+        actor_id  : $input.actor_id
+      }
+    } as $entry
+  }
+
+  response = $entry
+}
--- a/policies/CUSTOMER-EMAIL-AUDIT.xs
+++ b/policies/CUSTOMER-EMAIL-AUDIT.xs
@@ -0,0 +1,28 @@
+policy "CUSTOMER-EMAIL-AUDIT" {
+  title = "Changes to customer email tables are audited"
+  statement = "Every insert, update and delete of the customer contact tables (customers, users, newsletter_subscribers) calls the record_audit_event function right after the write, so who changed what is recorded in audit_log. A write that cannot audit must be reviewed by the policy owner before it is exempted."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "hipaa"]
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.add", tables: ["customers", "users", "newsletter_subscribers"] } }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.patch", tables: ["customers", "users", "newsletter_subscribers"] } }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.edit", tables: ["customers", "users", "newsletter_subscribers"] } }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.del", tables: ["customers", "users", "newsletter_subscribers"] } }
+  }
+}
--- a/policies/RET-001.xs
+++ b/policies/RET-001.xs
@@ -0,0 +1,18 @@
+policy "RET-001" {
+  title = "Only the audit function writes the audit log"
+  statement = "The audit log table audit_log must exist. Only the record_audit_event function may write to it, and no statement may edit, delete or truncate an audit entry. Audit entries are append-only."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "hipaa"]
+
+  rule {
+    check = "workspace.object_required"
+    params = { object_kind: "table", names: ["audit_log"] }
+  }
+
+  rule {
+    check = "table.write_location_restricted"
+    params = { restricted_tables: ["audit_log"], allowed_functions: ["record_audit_event"] }
+  }
+}
--- a/policies/SPEND-GUARD.xs
+++ b/policies/SPEND-GUARD.xs
@@ -0,0 +1,18 @@
+policy "SPEND-GUARD" {
+  title = "AI calls and task retries stay out of loops"
+  statement = "AI calls (agent runs and MCP tool runs) are never made inside a foreach, for or while loop, where one request can fan out into many billed calls. Background tasks never make an outbound request inside a while loop, the shape that retries forever. This is a proxy: it does not cap spend, and it does not bound retries counted with a for or foreach. Spend caps and retry limits are not checked by any rule."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["cost"]
+
+  rule {
+    check = "statement.containment"
+    params = { statements: ["ai.agent.run", "ai.external.mcp.tool.run"], must_not_be_inside: ["foreach", "for", "while"] }
+  }
+
+  rule {
+    check = "statement.containment"
+    params = { statements: ["api.request"], must_not_be_inside: ["while"], object_kinds: ["task"] }
+  }
+}
--- a/table/audit_log.xs
+++ b/table/audit_log.xs
@@ -0,0 +1,15 @@
+// Append-only record of changes to customer data: who changed which record, what changed, and when.
+table audit_log {
+  auth = false
+
+  schema {
+    int id
+    timestamp created_at?=now
+    text table_name
+    int record_id
+    text action
+    int actor_id?
+  }
+
+  index = [{type: "primary", field: [{name: "id"}]}]
+}
