--- a/function/record_audit_event.xs
+++ b/function/record_audit_event.xs
@@ -0,0 +1,25 @@
+// Writes one audit_log entry. The only code that writes to audit_log; called after each change to an audited table.
+function record_audit_event {
+  input {
+    int actor_id?
+    text action
+    text table_name
+    int record_id
+    text detail?
+  }
+
+  stack {
+    db.add audit_log {
+      data = {
+        actor_id: $input.actor_id,
+        action: $input.action,
+        table_name: $input.table_name,
+        record_id: $input.record_id,
+        detail: $input.detail
+      }
+    } as $entry
+  }
+
+  response = $entry
+  guid = "rec_audit_event_g07"
+}
--- a/policies/CHG-010.xs
+++ b/policies/CHG-010.xs
@@ -0,0 +1,23 @@
+policy "CHG-010" {
+  title = "Changes to users, customers, refunds and tenants are audited"
+  statement = "Every edit, patch and delete of the users, customers, refunds and tenants tables calls the record_audit_event function, so each change has an entry in the audit log. A change that cannot call it must be raised with the policy owner, not exempted."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc8.1"]
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.edit", tables: ["users", "customers", "refunds", "tenants"] } }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.patch", tables: ["users", "customers", "refunds", "tenants"] } }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["record_audit_event"], placement: "unconditional", when: { statement: "db.del", tables: ["users", "customers", "refunds", "tenants"] } }
+  }
+}
--- a/policies/RET-001.xs
+++ b/policies/RET-001.xs
@@ -0,0 +1,18 @@
+policy "RET-001" {
+  title = "Only the audit function writes the audit log"
+  statement = "The audit_log table exists, and only the record_audit_event function writes to it. Audit entries are not edited or deleted by any other code."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc8.1"]
+
+  rule {
+    check = "workspace.object_required"
+    params = { object_kind: "table", names: ["audit_log"] }
+  }
+
+  rule {
+    check = "table.write_location_restricted"
+    params = { restricted_tables: ["audit_log"], allowed_functions: ["record_audit_event"] }
+  }
+}
--- a/table/audit_log.xs
+++ b/table/audit_log.xs
@@ -0,0 +1,19 @@
+// Audit trail: one row per edit or delete of an audited table, written only by record_audit_event.
+table audit_log {
+  auth = false
+
+  schema {
+    int id
+    timestamp created_at?=now
+    int actor_id? {
+      table = "users"
+    }
+
+    text action
+    text table_name
+    int record_id
+    text detail?
+  }
+
+  index = [{type: "primary", field: [{name: "id"}]}]
+}
