--- a/function/require_admin_role.xs
+++ b/function/require_admin_role.xs
@@ -0,0 +1,20 @@
+// Stops the request unless the user is an admin or a support lead. Admin endpoints call it first.
+function require_admin_role {
+  input {
+    int user_id
+  }
+
+  stack {
+    db.get users {
+      field_name = "id"
+      field_value = $input.user_id
+    } as $user
+
+    precondition ($user.role == "admin" || $user.role == "support_lead") {
+      error_type = "accessdenied"
+      error = "Admins and support leads only."
+    }
+  }
+
+  response = $user
+}
--- a/policies/AUTH-002.xs
+++ b/policies/AUTH-002.xs
@@ -0,0 +1,13 @@
+policy "AUTH-002" {
+  title = "Admin endpoints check the caller's role"
+  statement = "Every endpoint tagged admin calls the require_admin_role function as its first statement, passing the logged-in user. Only admin and support_lead users may pass that check. An admin endpoint that cannot call it is reported, and the owner decides any exemption."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "hipaa"]
+
+  rule {
+    check = "object.statement_required"
+    params = {functions: ["require_admin_role"], placement: "first", must_reference: ["$auth"], tags: ["admin"], object_kinds: ["query"]}
+  }
+}
--- a/policies/TEN-001.xs
+++ b/policies/TEN-001.xs
@@ -0,0 +1,13 @@
+policy "TEN-001" {
+  title = "Tenant reads and writes filter on org_id"
+  statement = "Nothing reads or writes the tenants table without constraining org_id, so one org never reaches another org's tenants. A query that must span orgs needs an exemption decided by the policy owner."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2"]
+
+  rule {
+    check = "db.where_constraint_required"
+    params = {field: "org_id", table_selector: {names: ["tenants"]}}
+  }
+}
