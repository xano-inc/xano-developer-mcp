--- a/function/require_admin_role.xs
+++ b/function/require_admin_role.xs
@@ -0,0 +1,21 @@
+// Stops the request unless the logged-in user's role is admin or support_lead. Admin endpoints call it first.
+function require_admin_role {
+  input {
+    int user_id
+  }
+
+  stack {
+    db.get users {
+      field_name = "id"
+      field_value = $input.user_id
+    } as $user
+
+    precondition ($user.role == "admin" || $user.role == "support_lead") {
+      error_type = "accessdenied"
+      error = "Admin or support lead role required."
+    }
+  }
+
+  response = {allowed: true}
+  guid = "Rk2mV8hT4pQw1cXz6LnYbA9sEdU"
+}
--- a/policies/ADMIN-TENANT-ORG.xs
+++ b/policies/ADMIN-TENANT-ORG.xs
@@ -0,0 +1,17 @@
+policy "ADMIN-TENANT-ORG" {
+  title = "Tenant reads and writes filter on org_id"
+  statement = "Every read and write of the tenants table filters on org_id, so no query reaches tenant rows without choosing an org. Related to SOC 2 CC6.1 tenant isolation. Checks that an org_id filter is written, not which value it is given."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc6.1"]
+
+  rule {
+    check = "db.where_constraint_required"
+    params = {
+      field: "org_id"
+      table_selector: {names: ["tenants"]}
+      tables: ["tenants"]
+    }
+  }
+}
--- a/policies/AUTH-002.xs
+++ b/policies/AUTH-002.xs
@@ -0,0 +1,19 @@
+policy "AUTH-002" {
+  title = "Admin endpoints check the caller's role"
+  statement = "Every endpoint in the admin API group calls the require_admin_role function as its first statement, passing the logged-in user, so only admin and support_lead users get past it. Related to SOC 2 CC6.1 and HIPAA access control. Confirms the call comes first, not what the function decides. Endpoints under /admin/ outside the admin API group are not covered by this rule."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "cc6.1"]
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["require_admin_role"]
+      placement: "first"
+      must_reference: ["$auth"]
+      api_groups: ["admin"]
+      object_kinds: ["query"]
+    }
+  }
+}
