--- a/function/require_admin_role.xs
+++ b/function/require_admin_role.xs
@@ -0,0 +1,13 @@
+// Stops the request unless the caller's role is admin or support_lead. Admin endpoints call it first.
+function require_admin_role {
+  input {
+    text role
+  }
+
+  stack {
+    precondition ($input.role == "admin" || $input.role == "support_lead") {
+      error_type = "accessdenied"
+      error = "Admin or support lead role required"
+    }
+  }
+}
--- a/policies/AUTH-002.xs
+++ b/policies/AUTH-002.xs
@@ -0,0 +1,17 @@
+policy "AUTH-002" {
+  title = "Admin endpoints check the caller's role"
+  statement = "Every endpoint in the admin API group must call require_admin_role as its first statement, before it does anything else, so only admin and support_lead users get through. Endpoints are selected by API group, not by URL path: an endpoint under /admin in another API group is not judged."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "object.statement_required"
+    params = {
+      functions: ["require_admin_role"]
+      placement: "first"
+      api_groups: ["admin"]
+      object_kinds: ["query"]
+    }
+  }
+}
--- a/policies/TENANT-010.xs
+++ b/policies/TENANT-010.xs
@@ -0,0 +1,15 @@
+policy "TENANT-010" {
+  title = "Tenant reads and writes filter by org_id"
+  statement = "Every read and write of the tenants table must filter on org_id, so one org's tenants are never read or changed without naming the org."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "db.where_constraint_required"
+    params = {
+      field: "org_id"
+      table_selector: {names: ["tenants"]}
+    }
+  }
+}
