      "file": "build/policies/SEC-011.xs",
      "ok": true,
      "key": "SEC-011",
      "title": "External requests verify TLS certificates",
      "statement": "Every external request verifies the TLS certificate and host name of the server it talks to. Health data sent over an unverified connection is a HIPAA transmission-security gap.",
      "enforcement": "advisory",
      "active": true,
      "severity": "high",
      "rules": [
        {
          "id": "SEC-011.R1",
          "title": "",
          "check": "statement.param_forbidden",
          "params": {
            "statements": [
              "api.request",
              "stream.from_request"
            ],
            "param_names": [
              "verify_peer",
              "verify_host"
            ],
