--- a/policies/CONF-011.xs
+++ b/policies/CONF-011.xs
@@ -0,0 +1,13 @@
+policy "CONF-011" {
+  title = "Sensitive fields are marked sensitive"
+  statement = "The card and bank fields are marked sensitive wherever a table declares them. Related to PCI DSS requirement 3 (protect stored account data). Reads the table schemas only."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci-dss"]
+
+  rule {
+    check = "table.field_attribute_required"
+    params = {field_names: ["card_number", "card_cvv", "card_expiry", "cardholder_name", "card_last4", "bank_account_number", "bank_routing_number"], attribute: "sensitive"}
+  }
+}
--- a/policies/DATA-010.xs
+++ b/policies/DATA-010.xs
@@ -0,0 +1,13 @@
+policy "DATA-010" {
+  title = "Endpoints don't return personal data"
+  statement = "Endpoints never fetch the card and bank fields, or any field marked sensitive. Related to PCI DSS requirement 3 (protect stored account data). Judges what each database statement fetches in the endpoint and the functions it calls, not the final response."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci-dss"]
+
+  rule {
+    check = "db.output_fields_forbidden"
+    params = {object_kinds: ["query"], fields: ["card_number", "card_cvv", "card_expiry", "cardholder_name", "bank_account_number", "bank_routing_number"]}
+  }
+}
--- a/policies/LOG-001.xs
+++ b/policies/LOG-001.xs
@@ -0,0 +1,13 @@
+policy "LOG-001" {
+  title = "Logs don't contain request, user or secret data"
+  statement = "Debug logs never reference request input, the logged-in user or environment variables, so card and bank data cannot reach logs. Related to PCI DSS requirement 3 (protect stored account data). Only debug.log is checked; datadog.log is not read by this rule."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci-dss"]
+
+  rule {
+    check = "statement.expression_rule"
+    params = {statements: ["debug.log"], param_names: ["value"], must_not_reference: ["$input", "$auth", "$env"]}
+  }
+}
--- a/policies/PCI-CARD-001.xs
+++ b/policies/PCI-CARD-001.xs
@@ -0,0 +1,13 @@
+policy "PCI-CARD-001" {
+  title = "Card and bank data is never stored"
+  statement = "No table declares a card number, card security code, card expiry, cardholder name, or bank account or routing number. Related to PCI DSS requirement 3 (protect stored account data). Removing a declared field loses data, so the table owner decides how to migrate; an exemption is the policy owner's decision."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci-dss"]
+
+  rule {
+    check = "table.field_attribute_required"
+    params = {field_names: ["card_number", "card_cvv", "card_expiry", "cardholder_name", "bank_account_number", "bank_routing_number"], forbidden: true}
+  }
+}
--- a/policies/SEC-011.xs
+++ b/policies/SEC-011.xs
@@ -0,0 +1,13 @@
+policy "SEC-011" {
+  title = "External requests verify TLS certificates"
+  statement = "External requests never switch off TLS certificate or host checks, so card and bank data sent to a processor is protected in transit. Related to PCI DSS requirement 4 (encryption in transit)."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci-dss"]
+
+  rule {
+    check = "statement.param_forbidden"
+    params = {statements: ["api.request", "stream.from_request"], param_names: ["verify_peer", "verify_host"], values: [false]}
+  }
+}
--- a/policies/SEC-012.xs
+++ b/policies/SEC-012.xs
@@ -0,0 +1,12 @@
+policy "SEC-012" {
+  title = "No secrets are hardcoded"
+  statement = "API keys, tokens, private keys, encryption keys and credentialed URLs are never written as literals in an object's definition or agent settings; they belong in environment variables. Related to PCI DSS requirement 8 (credentials). A value already reviewed is exempted by its owner, never by editing the rule."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci-dss"]
+
+  rule {
+    check = "literal.credential_shape"
+  }
+}
--- a/policies/VND-001.xs
+++ b/policies/VND-001.xs
@@ -0,0 +1,13 @@
+policy "VND-001" {
+  title = "Data only goes to approved vendors"
+  statement = "Outbound requests are limited to the approved vendors: Stripe (api.stripe.com) and Plaid (production.plaid.com). Adding a vendor is the policy owner's decision. Related to PCI DSS requirement 12.8 (service providers)."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["pci-dss"]
+
+  rule {
+    check = "outbound.vendor_allowlist"
+    params = {hosts: ["api.stripe.com", "production.plaid.com"]}
+  }
+}
