--- a/policies/ERASE-001.xs
+++ b/policies/ERASE-001.xs
@@ -0,0 +1,13 @@
+policy "ERASE-001" {
+  title = "Account deletion erases personal data"
+  statement = "Every table tagged personal is reached by the erasure function, which deletes or anonymises a person's rows when their account is deleted. The erasure function carries the erasure tag. Tables that keep records for legal retention are anonymised, not deleted, and that choice belongs to the policy owner. This policy cannot see whether a row is personal in fact, only whether its table is tagged."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["gdpr"]
+
+  rule {
+    check = "table.coverage_required"
+    params = {tags: ["personal"], referenced_by: {object_kinds: ["function"], tags: ["erasure"], statements: ["db.del", "db.bulk.delete"]}}
+  }
+}
--- a/policies/RET-002.xs
+++ b/policies/RET-002.xs
@@ -0,0 +1,13 @@
+policy "RET-002" {
+  title = "Retained data has a cleanup task"
+  statement = "Every table tagged retained is deleted from by a scheduled task, so its rows are removed on a schedule. The task holds the retention period in its own query; no check reads the age of the rows it deletes. A table that must be kept longer is not tagged retained, and that choice belongs to its owner."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "gdpr"]
+
+  rule {
+    check = "table.coverage_required"
+    params = {tags: ["retained"], referenced_by: {object_kinds: ["task"], statements: ["db.del", "db.bulk.delete"]}}
+  }
+}
--- a/task/purge_expired_customer_data.xs
+++ b/task/purge_expired_customer_data.xs
@@ -0,0 +1,15 @@
+// Deletes support tickets and webhook deliveries older than two years every night.
+task purge_expired_customer_data {
+  stack {
+    db.bulk.delete support_tickets {
+      where = $db.support_tickets.created_at < ("now"|subtract_days:730)
+    } as $purged_tickets
+
+    db.bulk.delete webhook_deliveries {
+      where = $db.webhook_deliveries.created_at < ("now"|subtract_days:730)
+    } as $purged_deliveries
+  }
+
+  schedule = [{starts_on: 2026-01-01 04:00:00+0000, freq: 86400}]
+  tags = ["retained"]
+}
