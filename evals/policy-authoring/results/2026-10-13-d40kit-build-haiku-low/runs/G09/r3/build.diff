--- a/policies/GDPR-ERASE-001.xs
+++ b/policies/GDPR-ERASE-001.xs
@@ -0,0 +1,13 @@
+policy "GDPR-ERASE-001" {
+  title = "Account deletion erases personal data everywhere"
+  statement = "Every table tagged personal is erased by the account-erasure function, tagged erasure, when a user deletes their account. Records that must be kept for business or legal reasons are anonymised by that function rather than left linked to the person; a table outside this rule needs its own review."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["gdpr"]
+
+  rule {
+    check = "table.coverage_required"
+    params = { tags: ["personal"], referenced_by: { object_kinds: ["function"], tags: ["erasure"], statements: ["db.del", "db.bulk.delete"] } }
+  }
+}
--- a/policies/RET-002.xs
+++ b/policies/RET-002.xs
@@ -0,0 +1,13 @@
+policy "RET-002" {
+  title = "Retained data has a cleanup task"
+  statement = "Every table carrying your retained-data tag is referenced by a scheduled task that cleans it up."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "gdpr"]
+
+  rule {
+    check = "table.coverage_required"
+    params = { tags: ["retained"], referenced_by: { object_kinds: ["task"], statements: ["db.del", "db.bulk.delete"] } }
+  }
+}
--- a/task/purge_retained_personal_data.xs
+++ b/task/purge_retained_personal_data.xs
@@ -0,0 +1,23 @@
+// Deletes support tickets, customer notes and newsletter sign-ups older than two years.
+task purge_retained_personal_data {
+  stack {
+    var $cutoff {
+      value = now|subtract_secs_to_timestamp:63072000
+    }
+  
+    db.bulk.delete support_tickets {
+      where = $db.support_tickets.created_at < $cutoff
+    } as $tickets
+  
+    db.bulk.delete customer_notes {
+      where = $db.customer_notes.created_at < $cutoff
+    } as $notes
+  
+    db.bulk.delete newsletter_subscribers {
+      where = $db.newsletter_subscribers.created_at < $cutoff
+    } as $subscribers
+  }
+
+  schedule = [{starts_on: 2026-01-01 04:00:00+0000, freq: 86400}]
+  guid = "Qm7rT2kVbX9dLh4sWcZeNa1PyUo"
+}
