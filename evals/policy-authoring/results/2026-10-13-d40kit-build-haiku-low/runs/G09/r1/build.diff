--- a/policies/GDPR-ERASE.xs
+++ b/policies/GDPR-ERASE.xs
@@ -0,0 +1,20 @@
+policy "GDPR-ERASE" {
+  title = "Account deletion erases personal data"
+  statement = "Every table carrying the personal tag is deleted from by the erasure function, which runs when a user deletes their account. Orders are detached, not deleted, and are not covered by this rule."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+  tags = ["gdpr"]
+
+  rule {
+    check = "table.coverage_required"
+    params = {
+      tags: ["personal"],
+      referenced_by: {
+        object_kinds: ["function"],
+        tags: ["erasure"],
+        statements: ["db.del", "db.bulk.delete"]
+      }
+    }
+  }
+}
--- a/policies/RET-002.xs
+++ b/policies/RET-002.xs
@@ -0,0 +1,19 @@
+policy "RET-002" {
+  title = "Retained data has a cleanup task"
+  statement = "Every table carrying the retained tag is referenced by a scheduled task that cleans it up. Retention age is set inside each cleanup task and is not checked here."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "gdpr"]
+
+  rule {
+    check = "table.coverage_required"
+    params = {
+      tags: ["retained"],
+      referenced_by: {
+        object_kinds: ["task"],
+        statements: ["db.del", "db.bulk.delete", "db.truncate", "db.direct_query"]
+      }
+    }
+  }
+}
--- a/task/purge_stale_personal_data.xs
+++ b/task/purge_stale_personal_data.xs
@@ -0,0 +1,15 @@
+// Every night, deletes support tickets and webhook deliveries older than two years.
+task purge_stale_personal_data {
+  stack {
+    db.bulk.delete support_tickets {
+      where = $db.support_tickets.created_at < (now|subtract_days:730)
+    } as $purged_tickets
+
+    db.bulk.delete webhook_deliveries {
+      where = $db.webhook_deliveries.created_at < (now|subtract_days:730)
+    } as $purged_deliveries
+  }
+
+  schedule = [{starts_on: 2026-01-01 04:00:00+0000, freq: 86400}]
+  guid = "Ck3rW0sLQ9aVm2fTnP7xJ1dYe8E"
+}
