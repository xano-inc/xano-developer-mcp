--- a/policies/LOG-010.xs
+++ b/policies/LOG-010.xs
@@ -0,0 +1,12 @@
+policy "LOG-010" {
+  title = "External calls handle their own failures"
+  statement = "Every external request (api.request, stream.from_request, webflow.request, api.microservice, api.lambda) sits inside a try block, so a vendor outage or error reaches error handling instead of hanging or failing the caller. The catch branch must still handle the failure; this policy checks only that the try block is there."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.containment"
+    params = {statements: ["api.request", "stream.from_request", "webflow.request", "api.microservice", "api.lambda"], must_be_inside: ["try_catch"]}
+  }
+}
--- a/policies/SEC-013.xs
+++ b/policies/SEC-013.xs
@@ -0,0 +1,12 @@
+policy "SEC-013" {
+  title = "External requests time out quickly"
+  statement = "Every external request (api.request, stream.from_request, webflow.request, api.microservice, api.lambda) sets a timeout of at most 30 seconds, so one slow vendor cannot stall the app. A request that cannot meet this is reported to its owner, who decides whether to exempt it."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.param_bound"
+    params = {statements: ["api.request", "stream.from_request", "webflow.request", "api.microservice", "api.lambda"], param_names: ["timeout"], max: 30, unit: "seconds"}
+  }
+}
