--- a/policies/LOG-010.xs
+++ b/policies/LOG-010.xs
@@ -0,0 +1,15 @@
+policy "LOG-010" {
+  title = "External calls handle their own failures"
+  statement = "Every external request sits inside a try block, so a vendor failure reaches error handling."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.containment"
+    params = {
+      statements: ["api.request"],
+      must_be_inside: ["try_catch"]
+    }
+  }
+}
--- a/policies/SEC-013.xs
+++ b/policies/SEC-013.xs
@@ -0,0 +1,17 @@
+policy "SEC-013" {
+  title = "External requests time out quickly"
+  statement = "Every external request times out within 30 seconds, so one slow vendor cannot stall a workspace."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.param_bound"
+    params = {
+      statements: ["api.request", "stream.from_request", "webflow.request"],
+      param_names: ["timeout"],
+      max: 30,
+      unit: "seconds"
+    }
+  }
+}
