--- a/policies/LOG-010.xs
+++ b/policies/LOG-010.xs
@@ -0,0 +1,27 @@
+policy "LOG-010" {
+  title = "External calls handle their own failures"
+  statement = "Every external request sits inside a try block, so a vendor failure reaches error handling."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.containment"
+    params = {
+      statements: [
+        "api.request",
+        "stream.from_request",
+        "webflow.request",
+        "api.microservice",
+        "api.lambda",
+        "ai.external.mcp.tool.run",
+        "db.external.postgres.direct_query",
+        "db.external.mysql.direct_query",
+        "db.external.mssql.direct_query",
+        "db.external.oracle.direct_query",
+        "db.external.snowflake.direct_query"
+      ],
+      must_be_inside: ["try_catch"]
+    }
+  }
+}
--- a/policies/SEC-013.xs
+++ b/policies/SEC-013.xs
@@ -0,0 +1,37 @@
+policy "SEC-013" {
+  title = "External requests time out quickly"
+  statement = "Every external request sets its own timeout, and no timeout exceeds 30 seconds, so one slow vendor cannot stall a workspace."
+  severity = "medium"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "statement.param_bound"
+    params = {
+      statements: [
+        "api.request",
+        "stream.from_request",
+        "webflow.request",
+        "api.microservice",
+        "api.lambda"
+      ],
+      param_names: ["timeout"],
+      max: 30,
+      unit: "seconds"
+    }
+  }
+
+  rule {
+    check = "statement.param_required"
+    params = {
+      statements: [
+        "api.request",
+        "stream.from_request",
+        "webflow.request",
+        "api.microservice",
+        "api.lambda"
+      ],
+      param_names: ["timeout"]
+    }
+  }
+}
