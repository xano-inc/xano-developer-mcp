--- a/function/require_manager.xs
+++ b/function/require_manager.xs
@@ -0,0 +1,20 @@
+// Stops the call unless the user is a manager. Called first by endpoints that approve refunds or change prices.
+function require_manager {
+  input {
+    int user_id
+  }
+
+  stack {
+    db.get users {
+      field_name = "id"
+      field_value = $input.user_id
+    } as $me
+
+    precondition ($me.role == "manager") {
+      error_type = "accessdenied"
+      error = "Only managers can do this."
+    }
+  }
+
+  response = {manager: true}
+}
--- a/policies/AUTH-030.xs
+++ b/policies/AUTH-030.xs
@@ -0,0 +1,13 @@
+policy "AUTH-030" {
+  title = "Users can't make themselves admin"
+  statement = "Record writes never take a privilege field such as role from request input, nor a whole record from it. A user cannot raise their own role, for example to manager, through their profile endpoint."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "hipaa"]
+
+  rule {
+    check = "db.write_from_input_forbidden"
+    params = { fields: ["role"] }
+  }
+}
--- a/policies/SHOP-010.xs
+++ b/policies/SHOP-010.xs
@@ -0,0 +1,22 @@
+policy "SHOP-010" {
+  title = "Only managers approve refunds or change prices"
+  statement = "Only a user whose role is manager may approve a refund or change a product price. Every endpoint that does either calls require_manager before the write. Staff may view refunds and products but not change them."
+  severity = "high"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["require_manager"], placement: "unconditional", when: { statement: "db.patch", tables: ["products"] } }
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = { functions: ["require_manager"], placement: "unconditional", when: { statement: "db.edit", tables: ["refunds"] } }
+  }
+
+  rule {
+    check = "stack.statement_order"
+    params = { before: { functions: ["require_manager"] }, after: ["db.patch", "db.edit"], tables: ["products", "refunds"] }
+  }
+}
