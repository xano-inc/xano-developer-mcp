--- a/function/require_manager.xs
+++ b/function/require_manager.xs
@@ -0,0 +1,20 @@
+// Stops the call unless the given user has the manager role. Callers pass the logged-in user's id.
+function require_manager {
+  input {
+    int user_id
+  }
+
+  stack {
+    db.get users {
+      field_name = "id"
+      field_value = $input.user_id
+    } as $user
+
+    precondition ($user.role == "manager") {
+      error_type = "accessdenied"
+      error = "Only managers can do this."
+    }
+  }
+
+  response = {ok: true}
+}
--- a/policies/AUTH-002.xs
+++ b/policies/AUTH-002.xs
@@ -0,0 +1,27 @@
+policy "AUTH-002" {
+  title = "Refund and price changes check the caller is a manager"
+  statement = "Every stack that edits or patches refunds or products calls the require_manager function, unconditionally, so only users with the manager role can approve refunds or change prices. Staff can read both but not change them. A change that cannot call the check is a finding for the policy owner to decide, not something to exempt."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "object.statement_required"
+    params = {functions: ["require_manager"], placement: "unconditional", when: {statement: "db.edit", tables: ["refunds"]}}
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {functions: ["require_manager"], placement: "unconditional", when: {statement: "db.patch", tables: ["refunds"]}}
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {functions: ["require_manager"], placement: "unconditional", when: {statement: "db.edit", tables: ["products"]}}
+  }
+
+  rule {
+    check = "object.statement_required"
+    params = {functions: ["require_manager"], placement: "unconditional", when: {statement: "db.patch", tables: ["products"]}}
+  }
+}
--- a/policies/AUTH-030.xs
+++ b/policies/AUTH-030.xs
@@ -0,0 +1,12 @@
+policy "AUTH-030" {
+  title = "Users can't make themselves admin"
+  statement = "No write takes the role field from request input or copies a whole request body into a record, so a caller cannot give themselves the manager or admin role. Role changes come from a fixed value set by an authorised process, not from what the caller sends."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+
+  rule {
+    check = "db.write_from_input_forbidden"
+    params = {fields: ["role"]}
+  }
+}
