--- a/policies/SEC-012.xs
+++ b/policies/SEC-012.xs
@@ -0,0 +1,13 @@
+policy "SEC-012" {
+  title = "No secrets are hardcoded"
+  statement = "API keys, tokens, passwords, private keys, encryption keys and credentialed URLs are never written as literals in an object's definition or agent settings. They come from workspace environment variables ($env). A value that is not a secret, or a test fixture, is exempted by its reviewed fingerprint, signed off by the policy owner."
+  severity = "critical"
+  active = true
+  enforcement = "advisory"
+  tags = ["soc2", "pci_dss"]
+
+  rule {
+    check = "literal.credential_shape"
+    params = {}
+  }
+}
